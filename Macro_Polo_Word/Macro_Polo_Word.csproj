<?xml version="1.0" encoding="utf-8"?>
<!--
  A plain class library that Office loads as a COM shared add-in.

  This was a VSTO project. VSTO deploys through ClickOnce, which mandates signed application and
  deployment manifests - the build refuses to run without a certificate, and the manifests have to
  be re-signed for every recipient. A COM add-in is registered entirely from the registry and has
  no manifests, so nothing in this project needs a certificate at any point.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A256EB72-BC53-467A-AB5E-84B25970E7A8}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Macro_Polo_Word</RootNamespace>
    <AssemblyName>Macro_Polo_Word</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!--
      The assembly is registered by the installer, not by the build, so that building never needs
      an elevated prompt. See Macro_Polo_Installer\ComRegistration.wxs.
    -->
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!--
    Embedded, not referenced. Embedding (NoPIA) copies just the types actually used into this
    assembly, so no primary interop assembly has to be present in the GAC on the target machine -
    which matters for a plain file-copy deployment aimed at other people's machines.

    This was briefly switched off while chasing a crash that turned out to be an unrelated
    marshalling defect in the IDTExtensibility2 declaration. Embedding was not the cause, and the
    runtime dependency it avoids is worth having back. build\Test-ComSurface.ps1 now calls
    OnConnection through the COM vtable, which is the transition that failed then.
  -->
  <ItemGroup>
    <Reference Include="Office, Version=15.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c">
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Interop.Word, Version=15.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c">
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
    <Reference Include="stdole, Version=7.0.3300.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Include="WordAddIn.cs" />
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <AppDesigner Include="Properties\" />
  </ItemGroup>

  <!--
    Shared add-in plumbing, compiled into both add-ins. It cannot live in Macro_Polo.Core because
    it needs the Office interop types, and Core is deliberately free of Office references so that
    it remains testable and buildable on machines without Office.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\BannerPaneManager.cs">
      <Link>Shared\BannerPaneManager.cs</Link>
    </Compile>
    <Compile Include="..\Shared\ComAddInBase.cs">
      <Link>Shared\ComAddInBase.cs</Link>
    </Compile>
    <Compile Include="..\Shared\MacroPoloController.cs">
      <Link>Shared\MacroPoloController.cs</Link>
    </Compile>
    <Compile Include="..\Shared\PictureConverter.cs">
      <Link>Shared\PictureConverter.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ribbon1.xml" />
    <EmbeddedResource Include="Resources\word.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Macro_Polo.Core\Macro_Polo.Core.csproj">
      <Project>{3F2A6C1E-9D44-4C7B-8E52-0A1B7C6D5E90}</Project>
      <Name>Macro_Polo.Core</Name>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
